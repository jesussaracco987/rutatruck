generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String
  /// Opcional: las cuentas creadas por WhatsApp o por el alta asistida pueden
  /// no tener email y entrar con `telefonoLogin`.
  email             String?            @unique
  password          String
  role              Role
  phone             String?
  /// Teléfono con el que entra (formato wa.me, "549..."). Solo se completa
  /// cuando el teléfono está confirmado: lo cargó el equipo después de hablar
  /// por WhatsApp, o vino del propio WhatsApp. Es distinto de `phone`, que es
  /// un dato de contacto que cualquiera escribe y puede repetirse.
  telefonoLogin     String?            @unique
  createdAt         DateTime           @default(now())
  esFlota           Boolean            @default(false)
  emailVerified     Boolean            @default(false)
  notifZonaLat      Float?
  notifZonaLng      Float?
  notifRadioKm      Int?
  /// Canal por el que llegó antes de registrarse (ver lib/origen.ts).
  origenFuente      String?
  origenMedio       String?
  origenCampania    String?
  origenContenido   String?
  origenLanding     String?
  origenReferrer    String?
  /// Aceptación de Términos y Política de Privacidad en el registro.
  terminosAceptadosEn DateTime?
  /// Hasta cuándo vio (lado empresa) los avisos de transportistas disponibles en la campana.
  disponibilidadesVistasEn DateTime @default(now())
  cargas            Carga[]            @relation("EmpresaCarga")
  cargasAsignadas   Carga[]            @relation("TransportistaAsignado")
  cargasPrivadas    Carga[]            @relation("CargaPrivada")
  postulaciones     Postulacion[]
  pushSubscriptions PushSubscription[]
  disponibilidad          DisponibilidadTransportista?
  favoritosComoEmpresa    FavoritoTransportista[]      @relation("EmpresaFavoritos")
  favoritosComoTransp     FavoritoTransportista[]      @relation("TransportistaFavoritos")
  mensajes                Mensaje[]
  ratingPromedio          Float?
  ratingCantidad          Int                          @default(0)
  resenasEscritas         Resena[]                     @relation("ResenaAutor")
  resenasRecibidas        Resena[]                     @relation("ResenaDestinatario")
}

model DisponibilidadTransportista {
  id              Int      @id @default(autoincrement())
  transportistaId String   @unique
  vehiculo        String
  zona            String
  lat             Float
  lng             Float
  radioKm         Int?
  regresoVacio    Boolean  @default(false)
  buscaCarga      Boolean  @default(false)
  voyAPuerto      Boolean  @default(false)
  disponibleHoy   Boolean  @default(false)
  salidaDesde     String?
  salidaDestino   String?
  /// Coordenadas del viaje (origen → destino) para dibujarlo en el mapa y
  /// saber por qué zonas pasa. Línea recta aproximada, no la ruta real.
  salidaDesdeLat   Float?
  salidaDesdeLng   Float?
  salidaDestinoLat Float?
  salidaDestinoLng Float?
  /// Día en que está disponible / sale de viaje. Con fecha, la disponibilidad
  /// vence al terminar ese día (hora Argentina); sin fecha rige la regla de
  /// 24 h / 7 días (ver lib/disponibilidad.ts).
  fecha           DateTime? @db.Date
  /// Lugar que le queda: "vacio" | "parcial" | "chico" (ver lib/disponibilidad.ts).
  espacio         String?
  /// Texto libre: "2 pallets", "una caja de 1 m³".
  espacioDetalle  String?
  activo          Boolean  @default(true)
  actualizadoEn   DateTime @updatedAt
  /// Cuándo pasó de no disponible (inexistente, desactivada o vencida) a vigente.
  /// A diferencia de `actualizadoEn`, re-guardar estando vigente no la mueve:
  /// es lo que dispara el aviso a empresas y lo que cuenta la campana.
  disponibleDesde DateTime @default(now())
  transportista   User     @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
}

model FavoritoTransportista {
  id              Int      @id @default(autoincrement())
  empresaId       String
  transportistaId String
  creadoEn        DateTime @default(now())
  empresa         User     @relation("EmpresaFavoritos", fields: [empresaId], references: [id], onDelete: Cascade)
  transportista   User     @relation("TransportistaFavoritos", fields: [transportistaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, transportistaId])
}

model Carga {
  id                        Int           @id @default(autoincrement())
  titulo                    String
  origen                    String
  destino                   String
  tipoCarga                 String
  peso                      Float?
  volumen                   Float?
  presupuesto               Float?
  fechaCarga                DateTime
  descripcion               String?
  contactoNombre            String
  contactoTelefono          String
  contactoEmail             String
  estado                    EstadoCarga   @default(PENDIENTE_PAGO)
  pagado                    Boolean       @default(false)
  mpPaymentId               String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  empresaId                 String
  cantidadCamiones          Int           @default(1)
  destinoLat                Float?
  destinoLng                Float?
  disputaAbiertaPor         String?
  disputaDescripcion        String?
  fechaCupo                 DateTime?
  origenLat                 Float?
  origenLng                 Float?
  preferenciaCamion         String?
  tipoCargaDetalle          String?
  transportistaAsignadoId   String?
  transportistaMpPaymentId  String?
  transportistaPagoDeadline DateTime?
  recordatorioCompletarEnviadoEn DateTime?
  recordatorioSinPostulantesEnviadoEn DateTime?
  pesoUnidad                String?
  esPrivada                 Boolean       @default(false)
  /// Momento en que la carga pasó a FINALIZADA. Es el reloj de la retención del
  /// chat: usar updatedAt para eso hacía que cualquier update ajeno a la carga
  /// (un flag de recordatorio, por ejemplo) le regalara 24h más al hilo, y que
  /// mandar mensajes —que no toca la carga— no las extendiera nunca.
  finalizadaEn              DateTime?
  transportistaDestinadoId  String?
  empresa                   User          @relation("EmpresaCarga", fields: [empresaId], references: [id])
  transportistaAsignado     User?         @relation("TransportistaAsignado", fields: [transportistaAsignadoId], references: [id])
  transportistaDestinado    User?         @relation("CargaPrivada", fields: [transportistaDestinadoId], references: [id])
  postulaciones             Postulacion[]
  resenas                   Resena[]
}

model Postulacion {
  id                 Int               @id @default(autoincrement())
  cargaId            Int
  transportistaId    String
  mensaje            String?
  contactoEmail      String?
  contactoTelefono   String?
  estado             EstadoPostulacion @default(PENDIENTE)
  camionesCubiertos  Int               @default(1)
  precioOfrecido     Float?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  vistaTransportista Boolean           @default(false)
  vistaEmpresa       Boolean           @default(false)
  /// Momento en que el match quedó confirmado: al pagar la comisión, o al ser
  /// aceptada si corre FREE_TIER. Recién ahí se habilitan contacto y chat. El
  /// cobro es por postulación (y por camión que cubre): en una convocatoria de
  /// varios camiones cada transportista paga la suya.
  matchConfirmadoEn   DateTime?
  comisionMpPaymentId String?
  carga              Carga             @relation(fields: [cargaId], references: [id])
  transportista      User              @relation(fields: [transportistaId], references: [id])
  mensajes           Mensaje[]

  @@unique([cargaId, transportistaId])
}

/// Reseña bilateral de un viaje finalizado. Los puntajes son 1..5 y solo se
/// completan los tres criterios que aplican al `tipo`; los otros dos quedan en
/// null. `publicadaEn` implementa el doble ciego: la reseña no cuenta para el
/// promedio ni se muestra hasta que la contraparte también califica o pasan
/// DIAS_REVELADO días (cron `publicar-resenas`).
model Resena {
  id              Int        @id @default(autoincrement())
  cargaId         Int
  autorId         String
  destinatarioId  String
  tipo            TipoResena
  comunicacion    Int
  cumplioFecha    Int?
  integridadCarga Int?
  pagoEnTiempo    Int?
  datosReales     Int?
  promedio        Float
  comentario      String?
  creadaEn        DateTime   @default(now())
  publicadaEn     DateTime?
  carga           Carga      @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  autor           User       @relation("ResenaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  destinatario    User       @relation("ResenaDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@unique([cargaId, autorId, destinatarioId])
  @@index([destinatarioId, publicadaEn])
  @@index([publicadaEn, creadaEn])
}

/// Un hilo de chat es una Postulacion, no una Carga: en una convocatoria de
/// varios camiones hay varias postulaciones ACEPTADA sobre la misma carga, y
/// con la carga como clave todos los transportistas compartían la misma sala
/// —incluido el precio que cada uno había cerrado con la empresa—.
model Mensaje {
  id            Int         @id @default(autoincrement())
  postulacionId Int
  autorId       String
  cuerpo        String
  creadoEn      DateTime    @default(now())
  leidoEn       DateTime?
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  autor         User        @relation(fields: [autorId], references: [id])

  @@index([postulacionId, creadoEn])
  @@index([autorId, leidoEn])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  /// Recuperar contraseña por email. Los links de acceso de cuentas sin email
  /// (activación, WhatsApp) van por `userId`.
  email     String?
  userId    String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Código por email de la publicación por chat: se pide antes de que exista la
/// cuenta, por eso va por email y no por usuario. Guarda el hash, nunca el código.
model CodigoPublicacion {
  id         String   @id @default(cuid())
  email      String   @unique
  codigoHash String
  intentos   Int      @default(0)
  expiraEn   DateTime
  creadoEn   DateTime @default(now())
}

/// Contador por ventana de tiempo: límites por visitante y tope diario de tokens
/// de OpenAI. Va en la base porque cada función serverless tiene su propia memoria.
model LimiteUso {
  clave   String
  ventana DateTime
  conteo  Int      @default(0)

  @@id([clave, ventana])
  @@index([ventana])
}

/// Una conversación con el asistente de publicación, para medir dónde se equivoca.
/// Lo que la persona corrige en el resumen (borradorConfirmado vs borradorAsistente)
/// y en los audios es el error del bot. Se borra a los 90 días (cron limpiar-chat).
/// Sin relaciones: borrar la carga o la cuenta no tiene que tocar las métricas.
model ConversacionChat {
  /// Lo genera el navegador al primer mensaje.
  id                 String   @id
  /// Hash del visitante (ver claveVisitante), nunca la IP.
  visitante          String
  userId             String?
  /// "home" (sin cuenta) o "panel" (empresa con sesión).
  origen             String
  /// [{ rol, texto, dictado? }]: dictado es lo que transcribió el audio antes de que lo editaran.
  mensajes           Json     @default("[]")
  borradorAsistente  Json?
  borradorConfirmado Json?
  camposCorregidos   String[] @default([])
  /// chat < resumen < mapa < contacto < publicada
  pasoMaximo         String   @default("chat")
  preguntas          Int      @default(0)
  audios             Int      @default(0)
  audiosCorregidos   Int      @default(0)
  tokens             Int      @default(0)
  /// Último motivo por el que el asistente no respondió (límite, OpenAI caído).
  fallo              String?
  cargaId            Int?
  creadaEn           DateTime @default(now())
  actualizadaEn      DateTime @updatedAt

  @@index([creadaEn])
}

model ConfigApp {
  id                Int    @id @default(1)
  comisionTipo      String @default("FIJO")
  comisionValor     Float  @default(5000)
  /// Monto fijo por camión cuando la comisión es PORCENTAJE y la carga no tiene
  /// presupuesto ("a acordar"): sin base para el porcentaje, se cobra esto.
  comisionSinPresupuesto Float @default(5000)
  precioPublicacion Float  @default(500)
}

enum Role {
  EMPRESA
  TRANSPORTISTA
  ADMIN
  TRANSPORTISTA_FLOTA
  EMPRESA_TRANSPORTISTA
}

enum EstadoCarga {
  PENDIENTE_PAGO
  ACTIVA
  ASIGNADA
  FINALIZADA
  CANCELADA
  PENDIENTE_PAGO_TRANSPORTISTA
  EN_CONFIRMACION
  DISPUTA
}

enum TipoResena {
  A_TRANSPORTISTA
  A_EMPRESA
}

enum EstadoPostulacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

/// Pedido de alta de un transportista que prefiere que le creemos la cuenta
/// (botón "Quiero sumarme" de las landings). Lo completa en un formulario
/// corto, sigue la charla por WhatsApp y un admin le crea la cuenta desde
/// /admin/solicitudes. Guarda el canal de origen para atribuir la campaña.
model SolicitudTransportista {
  id              String   @id @default(cuid())
  nombre          String
  telefono        String
  email           String?
  localidad       String?
  vehiculo        String?
  /// PENDIENTE | CUENTA_CREADA | DESCARTADA
  estado          String   @default("PENDIENTE")
  userId          String?
  creadaEn        DateTime @default(now())
  atendidaEn      DateTime?
  origenFuente    String?
  origenMedio     String?
  origenCampania  String?
  origenContenido String?
  origenLanding   String?
  origenReferrer  String?

  @@index([estado, creadaEn])
}
